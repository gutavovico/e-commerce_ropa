# ==============================================================================
# FashionStore Backend - Plantilla de Variables de Producción (.env.production.example)
# ==============================================================================
# IMPORTANTE: En servicios cloud como Render, estas variables NO se suben a Git.
# Se configuran directamente en el panel de control:
# Dashboard -> Tu Servicio (fashionstore-backend) -> Environment -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS POSTGRESQL (NEON SERVERLESS) [OBLIGATORIA]
# ------------------------------------------------------------------------------
# Usa el endpoint con pooling de Neon (-pooler) y sslmode=require.
# Puedes usar la misma URL de Neon o la URL de una rama (branch) 'production' de Neon.
# El backend acepta tanto 'postgresql://' como 'postgresql+psycopg://'.
DATABASE_URL=postgresql+psycopg://neondb_owner:TU_PASSWORD_NEON@ep-tu-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. AUTENTICACIÓN Y SEGURIDAD (JWT) [OBLIGATORIA]
# ------------------------------------------------------------------------------
# NUNCA uses la clave de desarrollo en producción.
# Genera una clave segura de al menos 48 bytes ejecutando en terminal:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=genera_una_clave_aleatoria_segura_para_produccion

# Expiración del token en minutos (1440 = 24 horas)
JWT_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. POLÍTICA DE CORS (CROSS-ORIGIN RESOURCE SHARING) [CRÍTICO]
# ------------------------------------------------------------------------------
# Orígenes autorizados separados por coma.
# DEBES incluir aquí la URL asignada a tu frontend en Vercel (y localhost para pruebas).
CORS_ORIGINS=https://tu-frontend-en-vercel.vercel.app,http://localhost:4200

# Expresión regular para permitir dominios de previsualización automáticos de Vercel (*.vercel.app)
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# ------------------------------------------------------------------------------
# 4. SERVICIO DE CORREO SMTP GMAIL & CÓDIGOS OTP (CU33) [PRODUCCIÓN]
# ------------------------------------------------------------------------------
# Utilizado para el envío de códigos de recuperación de contraseña.
# Requiere una 'Contraseña de Aplicación' de Google de 16 caracteres (sin espacios).
# Generar en: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo-o-cuenta-del-proyecto@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion_google_16_caracteres
SMTP_USE_TLS=True
SMTP_FROM_NAME=Fashion Store Atelier

# Políticas de seguridad para códigos OTP
OTP_EXPIRE_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------------------
# 5. PASARELA DE PAGOS - STRIPE [CU16]
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder_fashionstore
STRIPE_WEBHOOK_SECRET=whsec_placeholder_fashionstore

# ------------------------------------------------------------------------------
# 6. INTELIGENCIA ARTIFICIAL - GOOGLE GEMINI [CU18 & CU19]
# ------------------------------------------------------------------------------
IA_API_KEY=tu_api_key_de_gemini
