# ==============================================================================
# FashionStore Backend - Plantilla de Variables de Entorno (.env.example)
# Proyecto: SI2 - Parcial 1 (E-commerce Omnicanal de Ropa)
# Copia este archivo como .env y completa tus valores reales.
# NUNCA subas .env al repositorio de control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS POSTGRESQL (NEON SERVERLESS) [OBLIGATORIA]
# ------------------------------------------------------------------------------
# Neon requiere conexion cifrada (?sslmode=require).
# Con SQLAlchemy y el driver psycopg v3 incluido en el proyecto, usa el esquema:
# postgresql+psycopg://[usuario]:[password]@[endpoint_id]-pooler.[region].aws.neon.tech/[bd]?sslmode=require
#
# Ejemplo Neon:
# DATABASE_URL=postgresql+psycopg://neondb_owner:npg_xxxx@ep-cool-snowflake-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Ejemplo local (Docker):
# DATABASE_URL=postgresql+psycopg://fashionstore_user:fashionstore_pass@localhost:5432/fashionstore_db
DATABASE_URL=postgresql+psycopg://neondb_owner:TU_PASSWORD_DE_NEON@ep-tu-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. AUTENTICACION Y SEGURIDAD (JWT) [OBLIGATORIA]
# ------------------------------------------------------------------------------
# Clave secreta para firmar tokens JWT (HS256). Minimo 32 caracteres.
# Puedes generar una clave segura con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=tu-clave-secreta-de-al-menos-32-caracteres-aleatorios

# Expiracion del token en minutos (por defecto 60)
JWT_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 3. POLITICA DE CORS (CROSS-ORIGIN RESOURCE SHARING) [OPCIONAL]
# ------------------------------------------------------------------------------
# Origenes web autorizados (separados por coma o formato JSON array)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://fashionstore-web.vercel.app

# ------------------------------------------------------------------------------
# 4. PASARELA DE PAGOS - STRIPE (SANDBOX / CU16) [OPCIONAL]
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder_fashionstore
STRIPE_WEBHOOK_SECRET=whsec_placeholder_fashionstore

# ------------------------------------------------------------------------------
# 5. INTELIGENCIA ARTIFICIAL (GEMINI / CU18 & CU19) [OPCIONAL]
# ------------------------------------------------------------------------------
IA_API_KEY=tu_api_key_de_ia_aqui
