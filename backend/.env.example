# -------------------------------------------------------
# FashionStore Backend - Variables de entorno
# Copia este archivo como .env y rellena los valores.
# NUNCA subas .env al repositorio.
# -------------------------------------------------------

# Conexion a PostgreSQL (obligatoria)
DATABASE_URL=

# JSON Web Token (obligatoria)
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# CORS - origenes permitidos, separados por coma
CORS_ORIGINS=http://localhost:4200

# Stripe (sandbox)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Servicio de IA
IA_API_KEY=
